(ns resale.phase-test
  "Phase 0→3 staged rollout through the OperationActor. The phase can only
  make the actor MORE conservative than the governor: hold writes that
  aren't enabled yet, force human approval before auto-commit is unlocked."
  (:require [kotoba.test :refer [deftest is testing]]
            [langgraph.graph :as g]
            [resale.store :as store]
            [resale.operation :as op]))

(def listing-agent {:actor-id "la-1" :actor-role :listing-agent})
(def officer {:actor-id "co-1" :actor-role :compliance-officer})

(def clean-intake
  {:op :item/intake :subject "it-950" :item-id "it-950" :category :apparel
   :brand "X" :condition-claimed :good :seller-id "sl-1" :price 40.00M})

(def clean-authenticate
  {:op :item/authenticate :subject "it-100" :item-id "it-100" :verdict :authentic
   :confidence 0.9 :condition-verified :good
   :source {:class :licensed-authentication-service :ref "demo" :license-id "lic-demo-auth"}})

(def clean-sale
  {:op :sale/confirm :subject "it-100" :item-id "it-100" :buyer-id "by-1"})

(def correction-req
  {:op :correction/request :subject "it-100" :disputed-field :condition-claimed :claim :fair})

(defn- run [phase req ctx]
  (let [s (store/seed-db)
        actor (op/build s)]
    [s (g/run* actor {:request req :context (assoc ctx :phase phase)}
               {:thread-id (str "ph-" phase "-" (:op req))})]))

(deftest phase0-holds-all-writes
  (let [[s res] (run 0 clean-intake listing-agent)]
    (is (= :hold (get-in res [:state :disposition])))
    (is (= :phase-disabled (-> (store/ledger s) first :phase-reason)))
    (is (nil? (store/item s "it-950")) "SSoT untouched in phase 0")))

(deftest phase0-allows-governed-reads
  (testing "disclosure/query is a read → phase 0 lets it through (governor still applies)"
    (let [[_ res] (run 0 {:op :disclosure/query :subject "it-100" :item-id "it-100"}
                      {:actor-id "sub-1" :actor-role :subscriber :tenant "tenant-basic"})]
      (is (= :commit (get-in res [:state :disposition]))))))

(deftest phase1-forces-approval-on-clean-intake
  (testing "a clean intake that auto-commits in phase 3 must go to a human in phase 1"
    (let [[_ res] (run 1 clean-intake listing-agent)]
      (is (= :interrupted (:status res)))
      (is (= :phase-approval (-> res :state :audit last :reason))))))

(deftest phase2-enables-authenticate-under-approval
  (let [[_ res] (run 2 clean-authenticate listing-agent)]
    (is (= :interrupted (:status res)))
    (is (= :phase-approval (-> res :state :audit last :reason)))))

(deftest phase3-auto-commits-clean-intake
  (let [[s res] (run 3 clean-intake listing-agent)]
    (is (= :commit (get-in res [:state :disposition])))
    (is (= :intake (:status (store/item s "it-950"))))))

(deftest phase3-auto-commits-clean-sale
  (let [[s res] (run 3 clean-sale listing-agent)]
    (is (= :commit (get-in res [:state :disposition])))
    (is (= :sold (:status (store/item s "it-100"))))))

(deftest governor-hold-beats-phase
  (testing "a hard governor violation (missing authentic verdict on a required category) holds even in the most permissive phase"
    (let [[_ res] (run 3 {:op :sale/confirm :subject "it-400" :item-id "it-400" :buyer-id "by-9"} listing-agent)]
      (is (= :hold (get-in res [:state :disposition]))))))

(deftest correction-request-never-auto-commits-at-any-phase
  (testing "a dispute never reaches :commit without an explicit human :approval"
    (doseq [ph [0 1 2 3]]
      (let [[_ res] (run ph correction-req officer)]
        (is (not= :commit (get-in res [:state :disposition]))
            (str "phase " ph " must not auto-commit a dispute"))))))
